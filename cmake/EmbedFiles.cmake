# Script mode: turn binary files into a C header of byte arrays.
#
#   cmake -DOUTPUT=<header> -DINPUTS=<a;b;...> -DNAMES=<sym_a;sym_b;...>
#         -DDEFINE=<MACRO> -P EmbedFiles.cmake
#
# Each input becomes `static const unsigned char <name>[]` plus
# `<name>_size`, and `#define <DEFINE> 1` is written at the top.

if(NOT OUTPUT OR NOT INPUTS OR NOT NAMES)
    message(FATAL_ERROR "EmbedFiles.cmake needs OUTPUT, INPUTS and NAMES")
endif()

set(content "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#pragma once\n")
if(DEFINE)
    string(APPEND content "#define ${DEFINE} 1\n")
endif()

list(LENGTH INPUTS count)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    list(GET INPUTS ${i} path)
    list(GET NAMES ${i} name)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "\nstatic const unsigned char ${name}[] = {\n${bytes}\n};\n")
    string(APPEND content "static const unsigned int ${name}_size = ${size};\n")
endforeach()

file(WRITE "${OUTPUT}" "${content}")
